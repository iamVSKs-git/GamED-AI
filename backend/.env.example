# GamED-AI — V4 Pipeline Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM API KEYS (at least one required)
# =============================================================================

# Google API Key — for Gemini models (RECOMMENDED)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# Groq API Key — FREE tier (Llama 3.1, Mixtral)
# Sign up at: https://console.groq.com
# Free tier: 14,400 requests/day
GROQ_API_KEY=gsk_your-groq-key-here

# =============================================================================
# AGENT MODEL PRESET (optional)
# =============================================================================

# Preset determines which models are used by each pipeline agent:
#   gemini_only  — All Gemini models (needs GOOGLE_API_KEY)
#   groq_free    — All Groq/Llama models (needs GROQ_API_KEY, FREE)
#   balanced     — Mix of providers (default)
# Auto-detected from available keys if not set.
# AGENT_CONFIG_PRESET=gemini_only

# =============================================================================
# WEB SEARCH (optional, improves diagram image retrieval)
# =============================================================================

# Serper API Key — for diagram image search
# Sign up at: https://serper.dev (free tier available)
# SERPER_API_KEY=your-serper-api-key-here

# =============================================================================
# DATABASE (optional, defaults to SQLite)
# =============================================================================

# DATABASE_URL=sqlite:///./gamed_ai_v2.db

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
# LOG_TO_FILE=true
# STRUCTURED_LOGGING=false

# =============================================================================
# CORS (optional, for API usage)
# =============================================================================

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
